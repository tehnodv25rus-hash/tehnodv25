<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Перевозка грузов эвакуаторами манипуляторами, бортовыми, самосвалами, тралами</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: system-ui, 'Segoe UI', 'Roboto', sans-serif;
        }
        body {
            background: #f0f2f5;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .card {
            max-width: 1100px;
            width: 100%;
            background: white;
            border-radius: 36px;
            box-shadow: 0 20px 35px -10px rgba(0,0,0,0.15);
            overflow: hidden;
        }
        .header {
            background: #1e3a5f;
            color: white;
            padding: 24px 28px;
        }
        .header h1 {
            margin: 0 0 6px;
            font-size: 1.5rem;
            line-height: 1.3;
        }
        .header p {
            opacity: 0.85;
            margin: 0;
        }
        .content {
            padding: 28px;
        }
        .mode-tabs {
            display: flex;
            gap: 16px;
            background: #f1f5f9;
            padding: 8px 12px;
            border-radius: 48px;
            margin-bottom: 28px;
        }
        .mode-tab {
            flex: 1;
            text-align: center;
            padding: 10px 0;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            background: transparent;
            color: #334155;
        }
        .mode-tab.active {
            background: #1e3a5f;
            color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .form-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            margin-bottom: 28px;
        }
        .form-group {
            flex: 1;
            min-width: 200px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.8rem;
            margin-bottom: 6px;
            color: #1e3a5f;
        }
        select, input {
            width: 100%;
            padding: 12px 14px;
            border-radius: 20px;
            border: 1px solid #cbd5e1;
            background: white;
            font-size: 0.95rem;
            transition: 0.2s;
        }
        select:focus, input:focus {
            outline: none;
            border-color: #1e3a5f;
            box-shadow: 0 0 0 2px rgba(30,58,95,0.2);
        }
        .city-panel, .suburb-panel {
            background: #f9fafc;
            padding: 18px;
            border-radius: 24px;
            margin-bottom: 24px;
        }
        .time-field {
            max-width: 300px;
        }
        .address-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 24px;
        }
        .address-row .form-group {
            margin-bottom: 0;
        }
        .car-details-block {
            background: #fef9e6;
            border-left: 4px solid #f59e0b;
            padding: 14px 18px;
            border-radius: 20px;
            margin-bottom: 24px;
            display: none;
        }
        .car-details-block.visible {
            display: block;
        }
        .car-details-block h4 {
            margin: 0 0 12px 0;
            font-size: 0.9rem;
            color: #b45309;
        }
        .car-brand-field {
            margin-bottom: 16px;
        }
        .car-brand-field label {
            font-weight: 500;
            font-size: 0.85rem;
            margin-bottom: 4px;
            display: block;
        }
        .detail-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 12px;
            align-items: center;
        }
        .detail-item {
            flex: 1;
            min-width: 150px;
        }
        .detail-item label {
            display: block;
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 4px;
            color: #4a5568;
        }
        .detail-item select {
            padding: 8px 10px;
            font-size: 0.85rem;
            background: white;
        }
        .photo-block {
            background: #f9fafc;
            padding: 18px;
            border-radius: 24px;
            margin-bottom: 24px;
        }
        .photo-label {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 8px;
            display: block;
            color: #1e3a5f;
        }
        .photo-hint {
            font-size: 0.75rem;
            color: #4b5563;
            margin-top: 6px;
        }
        .payment-group {
            display: flex;
            flex-wrap: nowrap;
            gap: 24px;
            background: #f8fafc;
            padding: 12px 20px;
            border-radius: 60px;
            margin: 20px 0;
            overflow-x: auto;
            white-space: nowrap;
        }
        .payment-group label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
            white-space: nowrap;
        }
        .contacts-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 24px;
            background: #fef9e6;
            padding: 18px;
            border-radius: 24px;
        }
        .contacts-row .form-group {
            flex: 1;
            margin-bottom: 0;
        }
        .result {
            background: #eef2ff;
            border-radius: 28px;
            padding: 20px 24px;
            border-left: 6px solid #1e3a5f;
            margin-top: 24px;
        }
        .price {
            font-size: 2.2rem;
            font-weight: 800;
            color: #1e3a5f;
        }
        .detail {
            margin-top: 16px;
            border-top: 1px solid #cbdff2;
            padding-top: 14px;
            font-size: 0.9rem;
            line-height: 1.45;
        }
        .warning {
            background: #fff3e3;
            border-left: 4px solid #f59e0b;
            padding: 10px 16px;
            border-radius: 20px;
            margin-top: 16px;
            font-size: 0.85rem;
        }
        .order-btn {
            display: block;
            width: 100%;
            background: #2b6e3c;
            color: white;
            font-weight: 700;
            font-size: 1.2rem;
            padding: 14px 0;
            border-radius: 60px;
            border: none;
            cursor: pointer;
            margin-top: 28px;
            transition: 0.2s;
            text-align: center;
        }
        .order-btn:hover {
            background: #1f5430;
            transform: scale(0.98);
        }
        @media (max-width: 700px) {
            .content { padding: 20px; }
            .price { font-size: 1.8rem; }
            .header h1 { font-size: 1.2rem; }
            .payment-group { gap: 16px; padding: 10px 16px; }
            .detail-row { flex-direction: column; gap: 10px; }
            .contacts-row { flex-direction: column; gap: 10px; }
        }
    </style>
</head>
<body>
<div class="card">
    <div class="header">
        <h1>🚛 Перевозка грузов эвакуаторами манипуляторами, бортовыми грузовиками, самосвалами, тралами</h1>
        <p>По городу — почасовая оплата | Загород — фиксированные цены</p>
    </div>
    <div class="content">
        <div class="mode-tabs" id="modeTabs">
            <div class="mode-tab active" data-mode="city">🏙️ По городу</div>
            <div class="mode-tab" data-mode="suburb">🌲 Загород</div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label>📦 Что везем</label>
                <select id="cargoSelect"></select>
                <div style="font-size:0.7rem; margin-top:5px;">Автоматически фильтрует доступные типы машин (список отсортирован по алфавиту)</div>
            </div>
            <div class="form-group">
                <label>🚚 Автомобиль (доступные под груз)</label>
                <select id="truckSelect">
                    <option value="5t">Борт 5т + КМУ 3т</option>
                    <option value="7t">Борт 7т + КМУ 3т</option>
                    <option value="10t">Борт 10т + КМУ 3т</option>
                    <option value="12t">Борт 12т + КМУ 5т</option>
                </select>
            </div>
        </div>

        <!-- Блок деталей для автомобилей -->
        <div id="carDetailsBlock" class="car-details-block">
            <h4>Дополнительно</h4>
            <div class="car-brand-field">
                <label>🚘 Марка автомобиля</label>
                <input type="text" id="carBrand" placeholder="Например: Toyota Camry, Hyundai Tucson...">
            </div>
            <div class="detail-row">
                <div class="detail-item">
                    <label>Колеса крутятся?</label>
                    <select id="wheelsSpin">
                        <option value="да">да</option>
                        <option value="нет">нет</option>
                    </select>
                </div>
                <div class="detail-item">
                    <label>Подъездной путь</label>
                    <select id="accessRoad">
                        <option value="без проблем">без проблем</option>
                        <option value="могут быть сложности">могут быть сложности</option>
                    </select>
                </div>
            </div>
            <div class="detail-row">
                <div class="detail-item">
                    <label>Наличие деревьев, проводов над автомобилем</label>
                    <select id="obstaclesPresence">
                        <option value="нет">нет</option>
                        <option value="есть">есть</option>
                        <option value="есть, но не помешают крану">есть, но не помешают крану</option>
                    </select>
                </div>
                <div class="detail-item">
                    <label>Документы на автомобиль</label>
                    <select id="documents">
                        <option value="предоставлю">предоставлю</option>
                        <option value="отсутствуют">отсутствуют</option>
                    </select>
                </div>
            </div>
            <div class="detail-row">
                <div class="detail-item">
                    <label>Электрокар</label>
                    <select id="electricCar">
                        <option value="нет">нет</option>
                        <option value="да">да</option>
                    </select>
                </div>
            </div>
        </div>

        <div id="cityPanel" class="city-panel">
            <div class="time-field">
                <label>⏱️ Время работы (часы)</label>
                <input type="number" id="hoursCity" value="2" step="1" min="2">
                <div style="font-size:0.7rem;">Первые 2 часа — базовый тариф, далее почасовая ставка</div>
            </div>
        </div>

        <div id="suburbPanel" class="suburb-panel" style="display: none;">
            <label>🗺️ Пункт назначения (из Владивостока)</label>
            <select id="destinationSelect"></select>
            <div style="font-size:0.7rem; margin-top:6px;">Фиксированная цена согласно прайс-листу</div>
        </div>

        <div class="address-row">
            <div class="form-group">
                <label>📍 Точный адрес места погрузки (заполнить)</label>
                <input type="text" id="pickupAddress" placeholder="Например: ул. Ленинская, 10" value="">
            </div>
            <div class="form-group">
                <label>📍 Точный адрес места выгрузки (заполнить)</label>
                <input type="text" id="deliveryAddress" placeholder="Например: ул. Находкинская, 5" value="">
            </div>
        </div>

        <div class="photo-block">
            <label class="photo-label">📎Прикрепить фотографии места погрузки, выгрузки</label>
            <input type="file" id="photoUpload" multiple accept="image/jpeg,image/png,image/jpg">
            <div class="photo-hint">
                Стоимость считается исходя из стандартного заказа. Сложный рельеф, подъездные пути, низкие провода, невозможность подъехать к грузу и др. могут увеличить стоимость перевозки. Рекомендуется прикрепить фотографии, чтобы избежать незапланированного повышения цены.
            </div>
        </div>

        <div class="payment-group">
            <span style="font-weight: 600;">💳 Способ оплаты:</span>
            <label><input type="radio" name="payment" value="cash" checked> Безнал</label>
            <label><input type="radio" name="payment" value="nds5"> НДС 5%</label>
            <label><input type="radio" name="payment" value="nds22"> НДС 22%</label>
        </div>

        <!-- Контактные данные -->
        <div class="contacts-row">
            <div class="form-group">
                <label>👤 Имя</label>
                <input type="text" id="clientName" placeholder="Иван Иванов" value="">
            </div>
            <div class="form-group">
                <label>📞 Номер телефона</label>
                <input type="tel" id="clientPhone" placeholder="+7 999 123-45-67" value="">
            </div>
        </div>

        <div class="result">
            <div>💰 Итоговая стоимость</div>
            <div class="price" id="finalPrice">— ₽</div>
            <div class="detail" id="priceDetails"></div>
            <div id="warningMsg" class="warning" style="display: none;"></div>
        </div>

        <button class="order-btn" id="orderBtn">📞 Заказать</button>

        <div style="font-size:0.7rem; text-align:center; margin-top: 16px;">
            ⚡ <strong>Городские тарифы:</strong> 5т (7000/2ч → 4000/ч) · 7т (10000→5000/ч) · 10т (13000→5500/ч) · 12т (15000→6000/ч)<br>
            🌲 <strong>Загород:</strong> фиксированные цены на направления.
        </div>
    </div>
</div>

<script>
    // ----- ТАРИФЫ ДЛЯ ГОРОДА (ТОЛЬКО ЧАСЫ) -----
    const cityTariffs = {
        '5t': { base2h: 7000, nextHour: 4000, name: '5т + КМУ 3т' },
        '7t': { base2h: 10000, nextHour: 5000, name: '7т + КМУ 3т' },
        '10t': { base2h: 13000, nextHour: 5500, name: '10т + КМУ 3т' },
        '12t': { base2h: 15000, nextHour: 6000, name: '12т + КМУ 5т' }
    };

    // ----- ФИКСИРОВАННЫЕ ЦЕНЫ ЗАГОРОД -----
    const suburbPrices = [
        { name: "Седанка / Ботанический сад / о. Русский ДВФУ", dist: 25, prices: { "5t": 9000, "7t": 13000, "10t": 17000, "12t": 20000 } },
        { name: "Океанская / Фанзавод / Сахарный ключ / Спутник", dist: 35, prices: { "5t": 10000, "7t": 14000, "10t": 19000, "12t": 22000 } },
        { name: "Садгород / ст. Весенняя / Угольная / Шамора / Де Фриз / Угловое", dist: 45, prices: { "5t": 11000, "7t": 15000, "10t": 19000, "12t": 22000 } },
        { name: "Артем / Двойка", dist: 50, prices: { "5t": 13000, "7t": 17000, "10t": 21000, "12t": 24000 } },
        { name: "Надеждинск, Соловей Ключ / Артем Грэс", dist: 55, prices: { "5t": 15000, "7t": 20000, "10t": 24000, "12t": 27000 } },
        { name: "Суражевка / Шкотово / Кипарисово / Раздольное", dist: 65, prices: { "5t": 19000, "7t": 24000, "10t": 29000, "12t": 32000 } },
        { name: "Уссурийск / Б.Камень / Барабаш", dist: 100, prices: { "5t": 21000, "7t": 27000, "10t": 34000, "12t": 37000 } },
        { name: "Фокино", dist: 120, prices: { "5t": 23000, "7t": 27000, "10t": 41000, "12t": 44000 } },
        { name: "Партизанск", dist: 170, prices: { "5t": 29000, "7t": 35000, "10t": 54000, "12t": 57000 } },
        { name: "Находка / Славянка", dist: 180, prices: { "5t": 31000, "7t": 40000, "10t": 59000, "12t": 62000 } },
        { name: "Врангель / Камень рыболов", dist: 210, prices: { "5t": 34000, "7t": 45000, "10t": 64000, "12t": 67000 } },
        { name: "Спасск / Арсеньев", dist: 250, prices: { "5t": 43000, "7t": 54000, "10t": 69000, "12t": 72000 } },
        { name: "Хабаровск", dist: 750, prices: { "5t": 109000, "7t": 134000, "10t": 154000, "12t": 159000 } }
    ];

    // ----- СПИСОК ГРУЗОВ (удалён "Экскаватор") -----
    const cargoDataRaw = [
        { name: "Автомобиль джип", allowed: ["5t"] },
        { name: "Автомобиль кроссовер", allowed: ["5t"] },
        { name: "Автомобиль легковой", allowed: ["5t"] },
        { name: "Автомобиль минивэн", allowed: ["5t"] },
        { name: "Автомобиль внедорожник", allowed: ["5t"] },
        { name: "Бочки", allowed: ["5t", "7t", "10t"] },
        { name: "Гараж дальзаводского", allowed: ["7t", "10t"] },
        { name: "Гараж сейф", allowed: ["7t", "10t"] },
        { name: "Гараж цельносборный", allowed: ["7t", "10t"] },
        { name: "Генератор", allowed: ["5t", "7t", "10t"] },
        { name: "Грузовик", allowed: ["7t", "10t"] },
        { name: "Жилой модуль", allowed: ["7t", "10t"] },
        { name: "Катушка", allowed: ["5t", "7t", "10t"] },
        { name: "Квадроцикл", allowed: ["5t"] },
        { name: "Контейнер 5ф", allowed: ["5t"] },
        { name: "Контейнер 10ф", allowed: ["7t", "10t"] },
        { name: "Контейнер 20ф", allowed: ["7t", "10t"] },
        { name: "Контейнер 40ф", allowed: ["traktor"] },
        { name: "Кунг", allowed: ["7t", "10t"] },
        { name: "Лодка, катер 5-7м", allowed: ["5t"] },
        { name: "Лодка, катер 7-12м", allowed: ["5t"] },
        { name: "Лодка, катер до 5м", allowed: ["5t"] },
        { name: "Микроавтобус", allowed: ["5t"] },
        { name: "Модуль 5ф", allowed: ["7t", "10t"] },
        { name: "Модуль 10ф", allowed: ["7t", "10t"] },
        { name: "Модуль 20ф", allowed: ["7t", "10t"] },
        { name: "Модуль 40ф", allowed: ["traktor"] },
        { name: "Мотоцикл", allowed: ["5t"] },
        { name: "Опалубка", allowed: ["5t", "7t", "10t"] },
        { name: "Септик", allowed: ["5t"] },
        { name: "Спецтехника", allowed: ["5t"] },
        { name: "Стекла", allowed: ["5t"] },
        { name: "Фронтальный погрузчик", allowed: ["7t", "10t"] },
        { name: "Эксоватор", allowed: ["7t", "10t"] }
    ];

    const cargoData = [...cargoDataRaw].sort((a, b) => a.name.localeCompare(b.name, 'ru'));

    const cargoSelect = document.getElementById('cargoSelect');
    cargoData.forEach(cargo => {
        const opt = document.createElement('option');
        opt.value = cargo.allowed.join(',');
        opt.textContent = cargo.name;
        opt.setAttribute('data-allowed', cargo.allowed.join(','));
        cargoSelect.appendChild(opt);
    });

    const destSelect = document.getElementById('destinationSelect');
    suburbPrices.forEach((dest, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = `${dest.name} (${dest.dist} км)`;
        destSelect.appendChild(opt);
    });

    // DOM элементы
    const truckSelect = document.getElementById('truckSelect');
    const cityPanel = document.getElementById('cityPanel');
    const suburbPanel = document.getElementById('suburbPanel');
    const modeTabs = document.querySelectorAll('.mode-tab');
    const finalPriceSpan = document.getElementById('finalPrice');
    const priceDetailsDiv = document.getElementById('priceDetails');
    const warningDiv = document.getElementById('warningMsg');
    const hoursCity = document.getElementById('hoursCity');
    const paymentRadios = document.querySelectorAll('input[name="payment"]');
    const carDetailsBlock = document.getElementById('carDetailsBlock');
    const carBrandInput = document.getElementById('carBrand');
    const wheelsSpin = document.getElementById('wheelsSpin');
    const accessRoad = document.getElementById('accessRoad');
    const obstaclesPresence = document.getElementById('obstaclesPresence');
    const documents = document.getElementById('documents');
    const electricCar = document.getElementById('electricCar');
    const orderBtn = document.getElementById('orderBtn');
    const clientName = document.getElementById('clientName');
    const clientPhone = document.getElementById('clientPhone');

    let currentMode = 'city';

    function isCarCargo() {
        const selected = cargoSelect.options[cargoSelect.selectedIndex]?.text;
        return selected && selected.startsWith("Автомобиль");
    }

    function toggleCarDetails() {
        if (isCarCargo()) {
            carDetailsBlock.classList.add('visible');
        } else {
            carDetailsBlock.classList.remove('visible');
            carBrandInput.value = '';
            wheelsSpin.value = 'да';
            accessRoad.value = 'без проблем';
            obstaclesPresence.value = 'нет';
            documents.value = 'предоставлю';
            electricCar.value = 'нет';
        }
    }

    function filterTrucksByCargo() {
        const selectedOption = cargoSelect.options[cargoSelect.selectedIndex];
        const allowedStr = selectedOption.getAttribute('data-allowed');
        if (!allowedStr) return;
        const allowed = allowedStr.split(',');
        if (allowed.includes('traktor')) {
            truckSelect.disabled = true;
            truckSelect.innerHTML = '<option value="">Тягач — уточняйте стоимость</option>';
            return;
        }
        truckSelect.disabled = false;
        const allOptions = { '5t': 'Борт 5т + КМУ 3т', '7t': 'Борт 7т + КМУ 3т', '10t': 'Борт 10т + КМУ 3т', '12t': 'Борт 12т + КМУ 5т' };
        let newHtml = '';
        for (let key of allowed) if (allOptions[key]) newHtml += `<option value="${key}">${allOptions[key]}</option>`;
        if (!newHtml) newHtml = '<option value="5t">Борт 5т + КМУ 3т</option>';
        truckSelect.innerHTML = newHtml;
        if (truckSelect.options.length) truckSelect.value = truckSelect.options[0].value;
    }

    function getPaymentMultiplier() {
        const selected = document.querySelector('input[name="payment"]:checked').value;
        if (selected === 'nds5') return 1.05;
        if (selected === 'nds22') return 1.22;
        return 1.0;
    }
    function getPaymentLabel() {
        const selected = document.querySelector('input[name="payment"]:checked').value;
        if (selected === 'nds5') return "НДС 5%";
        if (selected === 'nds22') return "НДС 22%";
        return "Безнал";
    }

    function calcCity(truckId, hours) {
        const t = cityTariffs[truckId];
        if (!t) return null;
        let totalHours = Math.max(2, hours);
        let extra = Math.max(0, totalHours - 2);
        let totalCost = t.base2h + extra * t.nextHour;
        return { baseTotal: Math.round(totalCost) };
    }

    function calcSuburb(truckId, destIndex) {
        const dest = suburbPrices[destIndex];
        if (!dest) return null;
        const fixedPrice = dest.prices[truckId];
        if (fixedPrice === undefined) return { error: `Нет цены для этого авто в данном направлении` };
        return { baseTotal: fixedPrice, routeName: dest.name, distance: dest.dist };
    }

    function update() {
        const selectedOption = cargoSelect.options[cargoSelect.selectedIndex];
        const allowedStr = selectedOption.getAttribute('data-allowed');
        if (allowedStr && allowedStr.includes('traktor')) {
            finalPriceSpan.innerHTML = "— ₽";
            priceDetailsDiv.innerHTML = "⚠️ Для выбранного груза требуется тягач. Уточните стоимость у менеджера.";
            warningDiv.style.display = 'block';
            warningDiv.innerHTML = "Тягач — стоимость отдельно.";
            return;
        }
        warningDiv.style.display = 'none';

        const truckId = truckSelect.value;
        if (!truckId) return;
        let result = null;
        if (currentMode === 'city') {
            let hrs = parseInt(hoursCity.value, 10);
            if (isNaN(hrs) || hrs < 2) hrs = 2;
            result = calcCity(truckId, hrs);
            if (!result) { finalPriceSpan.innerHTML = "Ошибка"; return; }
        } else {
            let idx = parseInt(destSelect.value, 10);
            if (isNaN(idx)) idx = 0;
            result = calcSuburb(truckId, idx);
            if (result.error) { finalPriceSpan.innerHTML = "Нет цены"; priceDetailsDiv.innerHTML = result.error; return; }
        }

        const multiplier = getPaymentMultiplier();
        const paymentLabel = getPaymentLabel();
        let finalTotal = result.baseTotal * multiplier;
        finalTotal = Math.round(finalTotal);
        const markup = finalTotal - result.baseTotal;
        const markupPercent = multiplier === 1 ? 0 : (multiplier-1)*100;

        finalPriceSpan.innerHTML = `${finalTotal.toLocaleString('ru-RU')} ₽`;

        const pickup = document.getElementById('pickupAddress').value.trim();
        const delivery = document.getElementById('deliveryAddress').value.trim();
        let addressText = '';
        if (pickup || delivery) addressText = `<p>📍 Погрузка: ${pickup || 'не указано'} | Выгрузка: ${delivery || 'не указано'}</p>`;

        let detailsHtml = `<p>🚚 Техника: ${cityTariffs[truckId].name}</p>`;
        const cargoName = cargoSelect.selectedOptions[0]?.text;
        if (cargoName) detailsHtml += `<p>📦 Везем: ${cargoName}</p>`;

        // Добавляем имя и телефон, если они заполнены
        const name = clientName.value.trim();
        const phone = clientPhone.value.trim();
        if (name) detailsHtml += `<p>👤 Имя: ${name}</p>`;
        if (phone) detailsHtml += `<p>📞 Телефон: ${phone}</p>`;

        if (isCarCargo()) {
            const brand = carBrandInput.value.trim();
            if (brand) detailsHtml += `<p>🚘 Марка: ${brand}</p>`;
            detailsHtml += `<p>🔧 Колеса крутятся? ${wheelsSpin.value}</p>`;
            detailsHtml += `<p>🛣️ Подъездной путь: ${accessRoad.value}</p>`;
            detailsHtml += `<p>🌳 Наличие деревьев, проводов над автомобилем: ${obstaclesPresence.value}</p>`;
            detailsHtml += `<p>📄 Документы на автомобиль: ${documents.value}</p>`;
            detailsHtml += `<p>⚡ Электрокар: ${electricCar.value}</p>`;
        }

        if (addressText) detailsHtml += addressText;

        if (currentMode === 'city') {
            detailsHtml += `<p>🏙️ <strong>По городу</strong> · ${result.baseTotal.toLocaleString('ru-RU')} ₽</p>`;
        } else {
            detailsHtml += `<p>🌲 <strong>Загород</strong> · ${result.routeName} (${result.distance} км)<br>📋 ${result.baseTotal.toLocaleString('ru-RU')} ₽</p>`;
        }

        if (markupPercent > 0) {
            detailsHtml += `<p>💳 Способ оплаты: ${paymentLabel} (+${markupPercent}%) = ${markup.toLocaleString('ru-RU')} ₽ наценка</p>`;
        } else {
            detailsHtml += `<p>💳 Способ оплаты: ${paymentLabel}</p>`;
        }
        detailsHtml += `<p>✨ <strong>Итого: ${finalTotal.toLocaleString('ru-RU')} ₽</strong></p>`;

        priceDetailsDiv.innerHTML = detailsHtml;
    }

    function setMode(mode) {
        currentMode = mode;
        cityPanel.style.display = mode === 'city' ? 'block' : 'none';
        suburbPanel.style.display = mode === 'suburb' ? 'block' : 'none';
        update();
    }

    modeTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            modeTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            setMode(tab.getAttribute('data-mode'));
        });
    });

    cargoSelect.addEventListener('change', () => { filterTrucksByCargo(); toggleCarDetails(); update(); });
    truckSelect.addEventListener('change', update);
    hoursCity.addEventListener('input', () => { if (currentMode === 'city') update(); });
    hoursCity.addEventListener('change', () => { let v = parseInt(hoursCity.value,10); if (isNaN(v)||v<2) hoursCity.value=2; if (currentMode==='city') update(); });
    destSelect.addEventListener('change', () => { if (currentMode === 'suburb') update(); });
    paymentRadios.forEach(r => r.addEventListener('change', update));
    document.getElementById('pickupAddress').addEventListener('input', update);
    document.getElementById('deliveryAddress').addEventListener('input', update);
    carBrandInput.addEventListener('input', update);
    wheelsSpin.addEventListener('change', update);
    accessRoad.addEventListener('change', update);
    obstaclesPresence.addEventListener('change', update);
    documents.addEventListener('change', update);
    electricCar.addEventListener('change', update);
    clientName.addEventListener('input', update);
    clientPhone.addEventListener('input', update);

    // ----- ОТПРАВКА НА ПОЧТУ -----
    const RECIPIENT_EMAIL = "manager@example.com"; // ЗАМЕНИТЕ НА РЕАЛЬНЫЙ EMAIL

    orderBtn.addEventListener('click', () => {
        const name = clientName.value.trim();
        const phone = clientPhone.value.trim();
        if (!name || !phone) {
            alert("Пожалуйста, заполните имя и номер телефона!");
            return;
        }

        const truckName = cityTariffs[truckSelect.value]?.name || "Не выбран";
        const cargoName = cargoSelect.selectedOptions[0]?.text || "Не выбран";
        const pickup = document.getElementById('pickupAddress').value.trim() || "не указан";
        const delivery = document.getElementById('deliveryAddress').value.trim() || "не указан";
        const payment = getPaymentLabel();
        const total = finalPriceSpan.innerText;
        const modeText = currentMode === 'city' ? "По городу" : "Загород";
        let routeInfo = "";
        if (currentMode === 'city') {
            const hours = hoursCity.value;
            routeInfo = `Время работы: ${hours} ч`;
        } else {
            const selectedIdx = destSelect.value;
            if (selectedIdx) {
                const dest = suburbPrices[parseInt(selectedIdx)];
                routeInfo = `Маршрут: ${dest.name} (${dest.dist} км)`;
            } else {
                routeInfo = "Маршрут не выбран";
            }
        }

        let body = `ЗАКАЗ НА ПЕРЕВОЗКУ

Клиент: ${name}
Телефон: ${phone}

Режим: ${modeText}
${routeInfo}

Техника: ${truckName}
Груз: ${cargoName}
Погрузка: ${pickup}
Выгрузка: ${delivery}
Способ оплаты: ${payment}
Сумма: ${total}`;

        if (isCarCargo()) {
            const brand = carBrandInput.value.trim();
            if (brand) body += `\nМарка авто: ${brand}`;
            body += `\nКолеса крутятся? ${wheelsSpin.value}
Подъездной путь: ${accessRoad.value}
Деревья/провода: ${obstaclesPresence.value}
Документы: ${documents.value}
Электрокар: ${electricCar.value}`;
        }

        const subject = encodeURIComponent("Новый заказ на перевозку");
        const mailBody = encodeURIComponent(body);
        window.location.href = `mailto:${RECIPIENT_EMAIL}?subject=${subject}&body=${mailBody}`;
    });

    filterTrucksByCargo();
    toggleCarDetails();
    setMode('city');
</script>
</body>
</html>
